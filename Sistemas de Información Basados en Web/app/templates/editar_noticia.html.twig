{% extends 'base.html.twig' %}

{% block estilos %}

    <link rel="stylesheet" href="css/estilos.css">

{% endblock %}


{% block body %}

    {% include 'header.html.twig' %}

    <main class="contenedor-principal">

        {% include 'menu.html.twig' %}

        <section class="zona-articulos">

            <h2>
                Editar noticia
            </h2>


            <!-- ============================= -->
            <!--            ERRORES            -->
            <!-- ============================= -->

            {% if errores %}

                <div class="errores">

                    {% for error in errores %}

                        <p>{{ error }}</p>

                    {% endfor %}

                </div>

            {% endif %}


            <!-- ============================= -->
            <!--         FORMULARIO            -->
            <!-- ============================= -->

            <form
                method="POST"
                enctype="multipart/form-data"
                class="form-comentarios"
                id="formEditarNoticia"
            >

                <label for="titulo">

                    Título

                </label>

                <input
                    type="text"
                    id="titulo"
                    name="titulo"
                    value="{{ noticia.titulo }}"
                    required
                >


                <label for="cuerpo">

                    Cuerpo

                </label>

                <textarea
                    id="cuerpo"
                    name="cuerpo"
                    required
                >{{ noticia.cuerpo }}</textarea>


                <label for="fecha">

                    Fecha

                </label>

                <input
                    type="date"
                    id="fecha"
                    name="fecha"
                    value="{{ noticia.fecha }}"
                    required
                >


                <label for="resumen">

                    Resumen

                </label>

                <input
                    type="text"
                    id="resumen"
                    name="resumen"
                    value="{{ noticia.resumen }}"
                >


                <label for="concejalia">

                    Concejalía

                </label>

                <input
                    type="text"
                    id="concejalia"
                    name="concejalia"
                    value="{{ noticia.concejalia }}"
                >


                <label for="responsables">

                    Responsables

                </label>

                <input
                    type="text"
                    id="responsables"
                    name="responsables"
                    value="{{ noticia.responsables }}"
                >

                <hr>

                <h3>
                    Imágenes actuales
                </h3>


                {% if imagenes %}

                    {% for imagen in imagenes %}

                        <div class="imagen-gestion">

                            <img
                                src="img/{{ imagen.archivo }}"
                                alt="{{ imagen.descripcion }}"
                            >

                            <p>

                                {{ imagen.archivo }}

                            </p>

                            <small>

                                {{ imagen.descripcion }}

                            </small>

                            <br>

                            <a
                                href="eliminar_imagen.php?id={{ imagen.id }}&noticia={{ noticia.id }}"
                                class="eliminar-imagen"
                                onclick="return confirm('¿Eliminar imagen?')"
                            >

                                ❌ Eliminar imagen

                            </a>

                        </div>

                    {% endfor %}

                {% endif %}


                <hr>

                <h3>
                    Añadir imagen
                </h3>


                <label for="archivo">

                    Archivo imagen

                </label>

                <input
                    type="file"
                    id="archivo"
                    name="archivo"
                    accept="image/*"
                >


                <label for="descripcion_imagen">

                    Descripción imagen

                </label>

                <input
                    type="text"
                    id="descripcion_imagen"
                    name="descripcion_imagen"
                >

                <label for="hashtags">

                    Hashtags

                </label>

                <input
                    type="text"
                    id="hashtags"
                    name="hashtags"
                    value="{{ hashtagsTexto }}"
                    placeholder="incendio, trafico, alerta"
                >

                <button type="submit">

                    Guardar cambios

                </button>

            </form>

        </section>

    </main>

    {% include 'footer.html.twig' %}

    <script src="js/interacciones.js"></script>

{% endblock %}