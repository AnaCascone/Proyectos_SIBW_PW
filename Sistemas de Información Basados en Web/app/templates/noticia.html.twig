{% extends 'base.html.twig' %}

{% block estilos %}

    <link rel="stylesheet" href="css/estilos.css">

{% endblock %}

{% block body %}

    {% include 'header.html.twig' %}

    <!-- Contenido principal -->
    <main class="contenedor-principal">

        <!-- MENÚ LATERAL -->
        {% include 'menu.html.twig' %}

        <!-- ZONA PRINCIPAL -->
        <section class="zona-articulos">
            <article class="detalle-noticia">
                <div class="cabecera-noticia">
                    <h2>{{ noticia.titulo }}</h2>
                </div>

                {% if esGestor %}

                    <div class="acciones-noticia-detalle">

                        <a
                            href="editar_noticia.php?id={{ noticia.id }}"
                            class="editar-noticia"
                        >

                            ✎ Editar noticia

                        </a>

                        <a
                            href="eliminar_noticia.php?id={{ noticia.id }}"
                            class="eliminar-noticia"
                            onclick="return confirm('¿Eliminar noticia?')"
                        >

                            ❌ Eliminar noticia

                        </a>

                    </div>

                {% endif %}

                <div class="datos-noticia">
                    <p><strong>Fecha:</strong> {{ noticia.fecha }} </p>
                    <p><strong>Resumen:</strong> {{ noticia.resumen }} </p>
                    <p><strong>Concejalía:</strong> {{ noticia.concejalia }} </p>
                    <p><strong>Responsables:</strong> {{ noticia.responsables }} </p>
                </div>

                {% if hashtags %}

                    <div class="hashtags-noticia">

                        {% for hashtag in hashtags %}

                            <span class="hashtag">

                                #{{ hashtag.nombre }}

                            </span>

                        {% endfor %}

                    </div>

                    <br>

                {% endif %}

                <div class="texto-noticia">
                    {{ noticia.cuerpo|nl2br }}
                    
                    {# Esto se pone para conservar los párrafos #}
                </div>

                <div class="galeria-noticia">

                    {% for imagen in imagenes %}

                    <figure>

                        <img src="img/{{ imagen.archivo }}"
                            alt="{{ imagen.descripcion }}">

                        <figcaption>
                            {{ imagen.descripcion }}
                        </figcaption>

                    </figure>

                    {% endfor %}

                </div>
            </article>
            
            <!--Botones flotantes para las RRSS e imprimir-->
            <div class="botones-flotantes">
                <a href="#" class="boton-social">
                    <img src="img/instagram.png" alt="Compartir en Instagram">
                </a>
                <a href="#" class="boton-social">
                    <img src="img/twitter.png" alt="Compartir en Twitter">
                </a>
                <a href="#" class="boton-social">
                    <img src="img/tiktok.png" alt="Compartir en TikTok">
                </a>
                <a href="noticia_imprimir.php?id={{ noticia.id }}" class="boton-social">
                    <img src="img/imprimir.png" alt="Imprimir">
                </a>
            </div>
        </section>
        

        <!-- PANEL DE COMENTARIOS -->
        <div id="trigger-panel"></div>

        <aside id="panel-comentarios">
            
            {% if usuarioSesion %}
                <div class="contenido-panel">

                    <button id="btnNuevoComentario">+ Nuevo comentario</button>

                    <form id="formComentario" class="form-comentarios oculto" method="POST" action="noticia.php?id={{ noticia.id }}">

                        <div id="erroresFormulario" class="errores oculto"></div>

                        <label for="comentario">Comentario</label>
                        <textarea id="comentario" name="comentario" placeholder="Escribe tu comentario aquí..." required></textarea>

                        <div class="botones-formulario">
                            <button type="submit" id="btnEnviarComentario">Enviar</button>
                            <button type="button" id="btnCancelarComentario">Cancelar</button>
                        </div>
                        
                    </form>
                
                {% else %}
                    
                    <p class="mensaje-login">
                        Debes <a href="login.php">iniciar sesión</a> para dejar un comentario.
                    </p>

                {% endif %}


                <div id="listaComentarios">

                    {% for comentario in comentarios %}

                        <div class="comentario">

                            <div class="cabecera-comentario">

                                <strong>
                                    {{ comentario.nombre }}
                                </strong>

                                {% if esModerador %}
                                
                                    <div class="acciones-comentario">

                                        <a
                                            href="editar_comentario.php?id={{ comentario.id }}"
                                            class="editar-comentario"
                                        >
                                            ✎
                                        </a>

                                        <a
                                            href="eliminar_comentario.php?id={{ comentario.id }}"
                                            class="eliminar-comentario"
                                        >
                                            ❌
                                        </a>

                                    </div>

                                {% endif %}

                            </div>

                            <small>
                                {{ comentario.fecha }}
                            </small>

                            <p>
                                {{ comentario.texto }}
                            </p>

                            {% if comentario.editado %}

                                <span class="comentario-editado">

                                    (Mensaje editado por moderador)

                                </span>

                            {% endif %}

                        </div>

                    {% endfor %}

                </div>

            </div>

        </aside>
    </main>

    {% include 'footer.html.twig' %}

    <!-- Pasamos las localidades a JavaScript para validación de formularios -->
    <div
        id="datos-localidades"
        data-localidades='{{ localidades|json_encode|e("html_attr") }}'>
    </div>

    <script src="js/interacciones.js"></script>

{% endblock %}